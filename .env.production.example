# Copy to .env on the production server. Never commit the completed file.
PUBLIC_DOMAIN=clinic.example.com
POSTGRES_DB=physiocare
POSTGRES_USER=physiocare_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_JWT_SECRET=replace-with-a-long-random-secret
APP_JWT_EXPIRATION_MS=3600000
# The session cookie is only ever sent over HTTPS in production.
APP_COOKIE_SECURE=true
# The clinic's local time zone. Dates on receipts, course usage, the day an
# appointment list shows and the month a commission closes in all follow it.
APP_TIMEZONE=Asia/Bangkok
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
# Google Calendar push (optional): OAuth client from Google Cloud Console.
# The redirect URI must be this API's public address + the callback path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.your-clinic.example/api/v1/integrations/google/callback
APP_FRONTEND_URL=https://your-clinic.example
