POSTGRES_DB=physiocare
POSTGRES_USER=physiocare
POSTGRES_PASSWORD=change-this-local-password
# Host port for the local database. Change it if something else
# already answers on 5432 (another PostgreSQL, for example).
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/physiocare
# For Docker with a shared cloud database, replace this with the provider's
# JDBC URL in each person's private .env file. Do not commit that URL.
DATABASE_URL_DOCKER=jdbc:postgresql://postgres:5432/physiocare
DATABASE_USERNAME=physiocare
DATABASE_PASSWORD=change-this-local-password
DATABASE_USERNAME_DOCKER=physiocare
DATABASE_PASSWORD_DOCKER=change-this-local-password
# Generate with: openssl rand -base64 32
APP_JWT_SECRET=replace-with-a-base64-secret-at-least-32-bytes
APP_JWT_EXPIRATION_MS=3600000
# The JWT is sent to the browser as an HttpOnly cookie. Local Docker and dev
# servers run on plain http, where a Secure cookie may be refused, so it is
# off here. Open the app as http://localhost:3000 (not 127.0.0.1): the API is
# on localhost:8080, and a SameSite cookie is only sent within the same site.
APP_COOKIE_SECURE=false
# The clinic's local time zone. Dates on receipts, course usage, the day an
# appointment list shows and the month a commission closes in all follow it.
APP_TIMEZONE=Asia/Bangkok
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
# Google Calendar push (optional). Each physiotherapist connects their own
# Google account from the account menu; their appointments are then written
# to their calendar. Leave GOOGLE_CLIENT_ID blank to keep the feature off.
# Create an OAuth client (Web application) in Google Cloud Console with the
# redirect URI below, and enable the Google Calendar API on that project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/integrations/google/callback
# Where Google sends the browser back to, and the base of the "Open in LA
# BALANCE" link inside every calendar event.
APP_FRONTEND_URL=http://localhost:3000
